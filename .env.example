# Docker Compose environment template
# Copy this file to .env and replace placeholder credentials locally.

NODE_ENV=development
APP_ENV=development
PORT=4000
APP_PORT=8000
APP_HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://mongo:27017/interviewai
MONGODB_DB=interviewai

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Service URLs
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000
BACKEND_INTERNAL_BASE_URL=http://node-api:4000
FASTAPI_PARSE_URL=http://fastapi:8000

# AI provider: choose openai or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voice services
STT_PROVIDER=whisper
WHISPER_MODEL=base
TTS_PROVIDER=none
COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
COQUI_GPU=false

# Optional scoring configuration
SCORING_WEIGHTS_JSON=

# Local storage and code evaluation
UPLOADS_DIR=uploads
CODE_EVAL_DOCKER_VOLUME=interviewai_code_eval_workspace

# Frontend service URLs
VITE_API_BASE_URL=http://localhost:4000/api
VITE_FASTAPI_BASE_URL=http://localhost:8000
VITE_FASTAPI_WS_BASE_URL=ws://localhost:8000

# Production-only values should be supplied by a secret manager, not committed:
# APP_ORIGIN=https://your-frontend-domain.example
# FRONTEND_PORT=8080
